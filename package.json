{
  "name": "Activity-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Repository containing api and client for activity tracker app",
  "license": "MIT",
  "author": "sjwilczynski <sjwilczynski@gmail.com>",
  "repository": "https://github.com/sjwilczynski/Activity-tracker.git",
  "workspaces": [
    "client",
    "api"
  ],
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules client/node_modules api/node_modules client/build api/dist",
    "dev": "bun run --filter '*' start",
    "knip": "knip",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix --deny-warnings",
    "pre-commit": "lint-staged --allow-empty",
    "size-limit": "size-limit"
  },
  "devDependencies": {
    "@size-limit/preset-app": "^12.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-storybook": "10.6.0",
    "husky": "9.1.7",
    "knip": "6.34.0",
    "lint-staged": "^16.2.7",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "size-limit": "^12.0.0",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxlint --type-aware --fix --deny-warnings",
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --type-aware --deny-warnings ."
    ],
    "!(*.{js,jsx,mjs,cjs,ts,tsx,mts,cts})": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": "^22.22.0 || >=24.0.0"
  }
}
