{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "analyze": "bunx vite-bundle-analyzer -m static -d gzip -o false",
    "build": "bun run typecheck && vite build",
    "build:e2e": "bun run typecheck && E2E=true vite build",
    "build-storybook": "bun run typecheck && storybook build",
    "generate-routes": "tsr generate",
    "prepare": "bun run generate-routes",
    "serve": "vite preview --outDir build/client",
    "serve:e2e": "vite preview --outDir build/client --port 3000",
    "start": "vite",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "bun run generate-routes && tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "0.2.6",
    "date-fns": "4.4.0",
    "firebase": "^12.18.0",
    "lucide-react": "^1.41.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/tanstack-react": "10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "5.102.8",
    "@tanstack/router-cli": "1.167.33",
    "@tanstack/router-plugin": "1.168.35",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "chromatic": "^18.7.2",
    "mockdate": "^3.0.5",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "oxc-transform-react": "0.145.0",
    "playwright": "^1.63.0",
    "storybook": "10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.11"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": "^22.22.1 || >=24.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
