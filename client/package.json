{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "analyze": "bunx vite-bundle-analyzer -m static -d gzip -o false",
    "build": "react-router build",
    "build:e2e": "E2E=true react-router build",
    "build-storybook": "storybook build",
