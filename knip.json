{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "client": {
      "entry": [
        "src/app/routes/**/*.tsx",
        "src/**/*.stories.tsx",
        "src/main.e2e.tsx"
      ],
      "project": ["src/**/*.{ts,tsx,css}"],
      "ignoreDependencies": ["chromatic"]
    },
    "api": {
      "entry": [
        "functions/*/index.ts",
        "scripts/migrate.ts",
        "scripts/migrate-local-test.ts"
      ],
      "project": ["**/*.ts"],
      "ignoreBinaries": ["func"],
      "ignore": ["utils/defaultCategories.ts"]
    }
  },
  "ignore": ["**/mocks/**"],
  "ignoreDependencies": ["husky"],
  "ignoreExportsUsedInFile": true
}
